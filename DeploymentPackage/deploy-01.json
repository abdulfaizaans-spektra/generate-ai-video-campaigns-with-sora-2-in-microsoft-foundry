{
  "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",

  "parameters": {
    "azureUserName": {
      "type": "string"
    },
    "azurePassword": {
      "type": "securestring"
    },
    "ODLID": {
      "type": "string"
    },
    "DeploymentID": {
      "type": "string"
    },
    "adminUsername": {
      "type": "string"
    },
    "adminPassword": {
      "type": "securestring"
    },
    "trainerUserName": {
      "type": "string"
    },
    "trainerUserPassword": {
      "type": "string"
    },
    "foundryLocation": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for the Microsoft Foundry resource, project, and the Sora 2 model deployment. Defaults to the resource group's region, but is kept as its own parameter (unlike the rest of this deployment, which always uses the resource group's region directly) because Sora 2 is a narrowly available preview model — as of this writing it is only confirmed available in eastus2. Because this template deploys the sora-2 model directly, the deployment will FAIL if this resolves to a region where Sora 2 isn't enabled for this subscription. Verify Sora 2 catalog availability for the target region before delivery, or override this parameter to a known-good region such as eastus2."
      }
    }
  },

  "variables": {
    "scripturl": "https://raw.githubusercontent.com/abdulfaizaans-spektra/generate-ai-video-campaigns-with-sora-2-in-microsoft-foundry/refs/heads/cloudlabs/v1-generate-ai-video-campaigns-with-sora-2--20260908/DeploymentPackage/psscript-01.ps1",

    "userdata": "[concat('$url = \"', variables('scripturl'), '\"; $arg = \"', variables('arg'), '\"')]",

    "arg": "[concat(variables('arg1'), variables('arg2'), variables('arg3'), variables('arg4'), variables('arg5'))]",

    "arg1": "[concat(' -AzureUserName ', parameters('azureUserName'), ' -AzurePassword ', parameters('azurePassword'))]",

    "arg2": "[concat(' -AzureTenantID ', variables('AzureTenantID'), ' -AzureSubscriptionID ', variables('AzureSubscriptionID'))]",

    "arg3": "[concat(' -ODLID ', parameters('ODLID'), ' -DeploymentID ', parameters('DeploymentID'))]",

    "arg4": "[concat(' -vmAdminUsername ', parameters('adminUsername'), ' -vmAdminPassword ', parameters('adminPassword'))]",

    "arg5": "[concat(' -trainerUserName ', parameters('trainerUserName'), ' -trainerUserPassword ', parameters('trainerUserPassword'))]",

    "AzureTenantID": "[subscription().tenantId]",

    "AzureSubscriptionID": "[subscription().subscriptionId]",

    "location": "[resourceGroup().location]",

    "rgName": "[resourceGroup().name]",

    "LabVMName": "[concat('labvm-', parameters('DeploymentID'))]",

    "networkInterfaceName": "[concat(variables('LabVMName'), '-nic')]",

    "publicIpAddressName": "[concat(variables('LabVMName'), '-pip')]",

    "publicIpAddressDNSName": "[concat('lab', parameters('DeploymentID'), 'vm', uniqueString(resourceGroup().id))]",

    "networkSecurityGroupName": "[concat(variables('LabVMName'), '-nsg')]",

    "virtualNetworkName": "[concat(variables('LabVMName'), '-vnet')]",

    "vnetID": "[resourceId('Microsoft.Network/virtualNetworks', variables('virtualNetworkName'))]",

    "subnetRef": "[concat(variables('vnetID'), '/subnets/subnet')]",

    "foundryHubName": "[concat('foundry-', parameters('DeploymentID'))]",

    "foundryProjectName": "[concat('foundry-project-', parameters('DeploymentID'))]",

    "soraDeploymentName": "sora2-campaign",

    "soraModelName": "sora-2",

    "soraModelVersion": "2025-12-08",

    "soraDeploymentSkuName": "GlobalStandard",

    "soraDeploymentCapacity": 3
  },

  "resources": [

    {
      "name": "[variables('LabVMName')]",
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2022-11-01",
      "location": "[variables('location')]",

      "dependsOn": [
        "[concat('Microsoft.Network/networkInterfaces/', variables('networkInterfaceName'))]"
      ],

      "plan": {
        "name": "win2019",
        "publisher": "spektra",
        "product": "cloudlabs-windows-jumpvm"
      },

      "properties": {

        "osProfile": {
          "computerName": "[variables('LabVMName')]",
          "adminUsername": "[parameters('adminUsername')]",
          "adminPassword": "[parameters('adminPassword')]",

          "windowsConfiguration": {
            "provisionVMAgent": true,
            "enableAutomaticUpdates": true
          }
        },

        "hardwareProfile": {
          "vmSize": "Standard_B2s"
        },

        "storageProfile": {

          "imageReference": {
            "publisher": "Spektra",
            "offer": "cloudlabs-windows-jumpvm",
            "sku": "win2019",
            "version": "latest"
          },

          "osDisk": {
            "name": "[concat(variables('LabVMName'), '-osdisk')]",
            "createOption": "FromImage",

            "managedDisk": {
              "storageAccountType": "StandardSSD_LRS"
            }
          },

          "dataDisks": []
        },

        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('networkInterfaceName'))]"
            }
          ]
        },

        "diagnosticsProfile": {
          "bootDiagnostics": {
            "enabled": true
          }
        },

        "userData": "[base64(variables('userdata'))]"
      },

      "tags": {
        "CloudLabs": "true",
        "DeploymentID": "[parameters('DeploymentID')]"
      }
    },

    {
      "name": "[variables('virtualNetworkName')]",
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2022-09-01",
      "location": "[variables('location')]",

      "properties": {

        "addressSpace": {
          "addressPrefixes": [
            "10.0.0.0/16"
          ]
        },

        "subnets": [
          {
            "name": "subnet",

            "properties": {
              "addressPrefix": "10.0.0.0/24"
            }
          }
        ]
      },

      "tags": {
        "CloudLabs": "true",
        "DeploymentID": "[parameters('DeploymentID')]"
      }
    },

    {
      "name": "[variables('networkInterfaceName')]",
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2022-09-01",
      "location": "[variables('location')]",

      "dependsOn": [
        "[concat('Microsoft.Network/virtualNetworks/', variables('virtualNetworkName'))]",
        "[concat('Microsoft.Network/publicIpAddresses/', variables('publicIpAddressName'))]",
        "[concat('Microsoft.Network/networkSecurityGroups/', variables('networkSecurityGroupName'))]"
      ],

      "properties": {

        "ipConfigurations": [
          {
            "name": "ipconfig1",

            "properties": {

              "subnet": {
                "id": "[variables('subnetRef')]"
              },

              "privateIPAllocationMethod": "Dynamic",

              "publicIpAddress": {
                "id": "[resourceId('Microsoft.Network/publicIpAddresses', variables('publicIpAddressName'))]"
              }
            }
          }
        ],

        "networkSecurityGroup": {
          "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('networkSecurityGroupName'))]"
        }
      },

      "tags": {
        "CloudLabs": "true",
        "DeploymentID": "[parameters('DeploymentID')]"
      }
    },

    {
      "name": "[variables('publicIpAddressName')]",
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2022-09-01",
      "location": "[variables('location')]",

      "sku": {
        "name": "Standard"
      },

      "tags": {
        "displayName": "Public IP",
        "CloudLabs": "true",
        "DeploymentID": "[parameters('DeploymentID')]"
      },

      "properties": {

        "publicIPAllocationMethod": "Static",

        "dnsSettings": {
          "domainNameLabel": "[variables('publicIpAddressDNSName')]"
        }
      }
    },

    {
      "name": "[variables('networkSecurityGroupName')]",
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2022-09-01",
      "location": "[variables('location')]",

      "properties": {

        "securityRules": [
          {
            "name": "default-allow-rdp",

            "properties": {
              "priority": 1000,
              "protocol": "TCP",
              "access": "Allow",
              "direction": "Inbound",
              "sourceAddressPrefix": "*",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "*",
              "destinationPortRange": "3389"
            }
          }
        ]
      },

      "tags": {
        "CloudLabs": "true",
        "DeploymentID": "[parameters('DeploymentID')]"
      }
    },

    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2025-06-01",

      "name": "[variables('foundryHubName')]",

      "location": "[parameters('foundryLocation')]",

      "kind": "AIServices",

      "sku": {
        "name": "S0"
      },

      "identity": {
        "type": "SystemAssigned"
      },

      "properties": {

        "customSubDomainName": "[variables('foundryHubName')]",

        "defaultProjectName": "[toLower(variables('foundryProjectName'))]",

        "publicNetworkAccess": "Enabled",

        "disableLocalAuth": false,

        "networkAcls": {
          "defaultAction": "Allow"
        },

        "allowProjectManagement": true
      },

      "tags": {
        "lab": "Sora2 Campaign lab",
        "project": "[variables('foundryProjectName')]",
        "CloudLabs": "true",
        "DeploymentID": "[parameters('DeploymentID')]",
        "ResourceExperience": "MicrosoftFoundry",
        "FoundryPortalExperience": "ProjectBased-NewPortal",
        "SoraDeployment": "[variables('soraDeploymentName')]"
      },

      "resources": [

        {
          "type": "projects",
          "apiVersion": "2025-06-01",

          "name": "[toLower(variables('foundryProjectName'))]",

          "location": "[parameters('foundryLocation')]",

          "identity": {
            "type": "SystemAssigned"
          },

          "sku": {
            "name": "S0"
          },

          "properties": {

            "displayName": "Sora Campaign Lab Project",

            "description": "Microsoft Foundry project for the Sora 2 eco-friendly product campaign lab, created as the account's default project."
          },

          "dependsOn": [
            "[resourceId('Microsoft.CognitiveServices/accounts', variables('foundryHubName'))]"
          ]
        }
      ]
    },

    {
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2025-07-01-preview",

      "name": "[concat(variables('foundryHubName'), '/', variables('soraDeploymentName'))]",

      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('foundryHubName'))]"
      ],

      "sku": {
        "name": "[variables('soraDeploymentSkuName')]",
        "capacity": "[variables('soraDeploymentCapacity')]"
      },

      "properties": {

        "model": {
          "format": "OpenAI",
          "name": "[variables('soraModelName')]",
          "version": "[variables('soraModelVersion')]"
        }
      },

      "tags": {
        "CloudLabs": "true",
        "DeploymentID": "[parameters('DeploymentID')]",
        "Lab": "Sora2Campaign",
        "Model": "[variables('soraModelName')]"
      }
    }
  ],

  "outputs": {

    "DeploymentID": {
      "type": "string",
      "value": "[parameters('DeploymentID')]"
    },

    "LabVM Admin Username": {
      "type": "string",
      "value": "[parameters('adminUsername')]"
    },

    "LabVM Admin Password": {
      "type": "string",
      "value": "[parameters('adminPassword')]"
    },

    "LabVM DNS Name": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpAddressName'))).dnsSettings.fqdn]"
    },

    "Trainer User Name": {
      "type": "string",
      "value": "[parameters('trainerUserName')]"
    },

    "Trainer Password": {
      "type": "string",
      "value": "[parameters('trainerUserPassword')]"
    },

    "Region": {
      "type": "string",
      "value": "[variables('location')]"
    },

    "Foundry Resource Name": {
      "type": "string",
      "value": "[variables('foundryHubName')]"
    },

    "Foundry Project Name": {
      "type": "string",
      "value": "[variables('foundryProjectName')]"
    },

    "Foundry Location": {
      "type": "string",
      "value": "[parameters('foundryLocation')]"
    },

    "Sora Deployment Name": {
      "type": "string",
      "value": "[variables('soraDeploymentName')]"
    },

    "Sora Model Name": {
      "type": "string",
      "value": "[variables('soraModelName')]"
    },

    "Sora Model Version": {
      "type": "string",
      "value": "[variables('soraModelVersion')]"
    }
  }
}
